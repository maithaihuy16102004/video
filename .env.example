# Copy to .env (git-ignored) and fill in. Never commit real keys.
GEMINI_API_KEY=

# Director V2 model routing (override without code changes)
DV2_TEXT_MODEL=gemini-3.5-flash-lite
DV2_VISION_MODEL=gemini-3.5-flash-lite
FAST_IMAGE_MODEL=gemini-3.1-flash-lite-image
MAIN_IMAGE_MODEL=gemini-3.1-flash-image
HERO_IMAGE_MODEL=gemini-3-pro-image

# Optional: legacy reviewer model
GEMINI_REVIEW_MODEL=gemini-3.5-flash-lite
