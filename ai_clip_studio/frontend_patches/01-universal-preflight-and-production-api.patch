diff --git a/sites/ai-clip-studio/app/api/production/approve-master/route.ts b/sites/ai-clip-studio/app/api/production/approve-master/route.ts
new file mode 100644
index 0000000..4fef5b2
--- /dev/null
+++ b/sites/ai-clip-studio/app/api/production/approve-master/route.ts
@@ -0,0 +1,33 @@
+import { NextResponse } from "next/server";
+
+// Human approval gate: only a draft in END_TO_END_DRAFT_READY_FOR_REVIEW
+// may become a Master. The pipeline server enforces this (409 otherwise);
+// this route only proxies. No auto-approval: a numeric QA score alone
+// never approves a Master.
+const backend = () =>
+  process.env.PRODUCTION_BACKEND_URL || "http://127.0.0.1:8788";
+
+export async function POST(request: Request) {
+  try {
+    const { job_id } = await request.json();
+    if (!job_id) {
+      return NextResponse.json({ error: "job_id is required" }, { status: 400 });
+    }
+    const r = await fetch(
+      `${backend()}/api/production/jobs/${encodeURIComponent(job_id)}/approve-master`,
+      { method: "POST" },
+    );
+    return new NextResponse(await r.text(), {
+      status: r.status,
+      headers: { "content-type": "application/json" },
+    });
+  } catch {
+    return NextResponse.json(
+      {
+        error:
+          "Production backend chưa chạy (8788). Chạy: python -m ai_clip_studio.server",
+      },
+      { status: 503 },
+    );
+  }
+}
