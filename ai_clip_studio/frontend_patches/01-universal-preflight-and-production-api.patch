@@ -0,0 +1,32 @@
+import { NextResponse } from "next/server";
+
+// Proxy to the unified production pipeline (ai_clip_studio server, 8788).
+// POST {script, language?, aspect_ratio?} -> {job_id, status: "queued", script_hash}
+// The job runs in a background thread on 8788; poll
+// GET /api/production/jobs/{job_id} for progress. Never returns SUCCESS
+// before the render + upload actually complete.
+const backend = () =>
+  process.env.PRODUCTION_BACKEND_URL || "http://127.0.0.1:8788";
+
+export async function POST(request: Request) {
+  try {
+    const body = await request.text();
+    const r = await fetch(`${backend()}/api/production/draft`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body,
+    });
+    return new NextResponse(await r.text(), {
+      status: r.status,
+      headers: { "content-type": "application/json" },
+    });
+  } catch {
+    return NextResponse.json(
+      {
+        error:
+          "Production backend chưa chạy (8788). Chạy: python -m ai_clip_studio.server",
+      },
+      { status: 503 },
+    );
+  }
+}
