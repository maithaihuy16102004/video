diff --git a/sites/ai-clip-studio/app/api/production/retry-upload/route.ts b/sites/ai-clip-studio/app/api/production/retry-upload/route.ts
new file mode 100644
index 0000000..b1c6f4c
--- /dev/null
+++ b/sites/ai-clip-studio/app/api/production/retry-upload/route.ts
@@ -0,0 +1,33 @@
+import { NextResponse } from "next/server";
+
+// Retry the Drive upload for a finished job WITHOUT re-rendering.
+// The pipeline server currently returns 501 for this (not implemented
+// yet — see ai_clip_studio/STATUS.md); this route passes that through
+// honestly instead of faking a successful retry.
+const backend = () =>
+  process.env.PRODUCTION_BACKEND_URL || "http://127.0.0.1:8788";
+
+export async function POST(request: Request) {
+  try {
+    const { job_id } = await request.json();
+    if (!job_id) {
+      return NextResponse.json({ error: "job_id is required" }, { status: 400 });
+    }
+    const r = await fetch(
+      `${backend()}/api/production/jobs/${encodeURIComponent(job_id)}/retry-upload`,
+      { method: "POST" },
+    );
+    return new NextResponse(await r.text(), {
+      status: r.status,
+      headers: { "content-type": "application/json" },
+    });
+  } catch {
+    return NextResponse.json(
+      {
+        error:
+          "Production backend chưa chạy (8788). Chạy: python -m ai_clip_studio.server",
+      },
+      { status: 503 },
+    );
+  }
+}
