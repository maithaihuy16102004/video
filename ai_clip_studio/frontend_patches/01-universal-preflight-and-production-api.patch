+import { NextResponse } from "next/server";
+
+// Proxy to the unified production pipeline (ai_clip_studio server, 8788).
+// GET /api/production/jobs/{job_id} -> job status + per-stage results.
+// Flattens drive_links / drive_url out of the RETURN_DRIVE_LINKS stage
+// so the page can show a clickable Drive link without digging into stages.
+const backend = () =>
+  process.env.PRODUCTION_BACKEND_URL || "http://127.0.0.1:8788";
+
+export async function GET(
+  _request: Request,
+  { params }: { params: Promise<{ jobId: string }> },
+) {
+  const { jobId } = await params;
+  try {
+    const r = await fetch(
+      `${backend()}/api/production/jobs/${encodeURIComponent(jobId)}`,
+      { cache: "no-store" },
+    );
+    const d = await r.json();
+    if (r.ok && Array.isArray(d.stages)) {
+      const linksStage = d.stages.find(
+        (s: any) => s.stage === "RETURN_DRIVE_LINKS",
+      );
+      const links: string[] = linksStage?.data?.drive_links || [];
+      d.drive_links = links;
+      d.drive_url = links[0] || null;
+      const uploadStage = d.stages.find(
+        (s: any) => s.stage === "UPLOAD_ARTIFACTS_TO_GOOGLE_DRIVE",
+      );
