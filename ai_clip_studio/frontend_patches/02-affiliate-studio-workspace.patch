+import { NextResponse } from "next/server";
+
+// Catch-all proxy to the Affiliate Studio API on the unified pipeline
+// server (ai_clip_studio, :8788): /api/affiliate/* -> :8788/api/affiliate/*.
+// The backend owns the schema, gates, and stages; this route only
+// forwards status + body verbatim (including 403 gate refusals and
+// the honest 501 for the not-yet-wired export stage). Never returns
+// SUCCESS before the backend actually completes the work.
+const backend = () =>
+  process.env.PRODUCTION_BACKEND_URL || "http://127.0.0.1:8788";
+
+async function proxy(request: Request, path: string[]) {
+  const target = `${backend()}/api/affiliate/${path.join("/")}`;
+  try {
+    const init: RequestInit = { method: request.method };
+    if (request.method !== "GET" && request.method !== "HEAD") {
+      init.headers = { "content-type": "application/json" };
+      init.body = await request.text();
+    }
+    const r = await fetch(target, init);
+    return new NextResponse(await r.text(), {
+      status: r.status,
+      headers: { "content-type": "application/json" },
+    });
+  } catch {
+    return NextResponse.json(
+      {
+        error:
+          "Affiliate backend chưa chạy (8788). Chạy: python -m ai_clip_studio.server",
+      },
+      { status: 503 },
+    );
+  }
+}
+
+export async function GET(
+  request: Request,
+  { params }: { params: Promise<{ path: string[] }> },
+) {
+  return proxy(request, (await params).path);
+}
+
+export async function POST(
+  request: Request,
+  { params }: { params: Promise<{ path: string[] }> },
+) {
+  return proxy(request, (await params).path);
+}
