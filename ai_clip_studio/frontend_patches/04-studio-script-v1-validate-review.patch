+// STUDIO SCRIPT V1 validate + review panel (DIRECTIVE §2: paste -> parse
+// and validate -> display characters/locations/props/scenes/shots,
+// narration and dialogue, SFX/ambience/BGM/VFX, line-numbered errors,
+// review before production).
+//
+// Talks to POST /api/production/validate, which proxies the :8788
+// ai_clip_studio server (same endpoint and response shape as the
+// server UI). The review is rendered GENERICALLY by walking the
+// returned structure: known fields get Vietnamese labels, unknown
+// fields still display under their own key — so both the original
+// dialect and the newer FIRST_PERSON_ROLEPLAY dialect (storytelling
+// mode, primary character, external narrator, end card, QA expected
+// counts, OUTPUT block) display correctly without hardcoding either
+// dialect's field names. Nothing here re-implements parsing and no
+// validation rule lives in this panel: errors come from the backend.
+
+export interface V1ValidationIssue {
+  line: number;
+  code: string;
+  message: string;
+}
+
+export interface V1ValidationResult {
+  format: string;
+  valid: boolean;
+  snapshot_hash?: string;
+  note?: string;
+  errors?: V1ValidationIssue[];
+  warnings?: V1ValidationIssue[];
+  summary?: Record<string, any>;
+  review?: Record<string, any>;
+}
+
+export interface V1ValidationVerdict {
+  script: string;
+  format: string;
+  valid: boolean;
+}
+
+interface ScriptReviewPanelProps {
+  script: string;
+  // Reported on every completed check so the parent page can gate the
+  // Unified Pipeline draft on a FAILED V1 validation. Free-form
+  // scripts report valid=true and are never blocked. Null on a
+  // failed request (no verdict — the backend still refuses invalid V1).
+  onValidation?: (verdict: V1ValidationVerdict | null) => void;
+}
