+import { NextResponse } from "next/server";
+
+// Proxy to the unified production pipeline (ai_clip_studio server, 8788).
+// POST {script} -> STUDIO SCRIPT V1 validation + human-readable review:
+//   200 valid V1 (review) or free-form script (freeform note, never blocked)
+//   422 invalid V1, with the full line-numbered error list
+// Status and body pass through unchanged (including 422) so the review
+// panel can render the real error list. Same backend endpoint and shape
+// as the :8788 server UI (/api/production/validate); no new backend
+// endpoint is invented here.
+const backend = () =>
+  process.env.PRODUCTION_BACKEND_URL || "http://127.0.0.1:8788";
+
+export async function POST(request: Request) {
+  try {
+    const body = await request.text();
+    const r = await fetch(`${backend()}/api/production/validate`, {
+      method: "POST",
+      headers: { "content-type": "application/json" },
+      body,
+    });
+    return new NextResponse(await r.text(), {
+      status: r.status,
+      headers: { "content-type": "application/json" },
+    });
+  } catch {
+    return NextResponse.json(
+      {
+        error:
+          "Production backend chưa chạy (8788). Chạy: python -m ai_clip_studio.server",
+      },
+      { status: 503 },
+    );
+  }
+}
