+
+function labelFor(key: string): string {
+  return FIELD_LABELS[key] || key;
+}
+
+function renderValue(value: any, depth: number): React.ReactNode {
+  if (value === null || value === undefined || value === "") return "—";
+  if (Array.isArray(value)) {
+    if (value.length === 0) return "—";
+    return value.map((v, i) => (
+      <span key={i}>
+        {i > 0 ? "; " : ""}
+        {renderValue(v, depth + 1)}
+      </span>
+    ));
+  }
+  if (typeof value === "object") {
+    const keys = Object.keys(value);
+    if (keys.length === 0) return "—";
+    if (depth >= 1) {
+      return keys
+        .map((k) => `${labelFor(k)}: ${String(value[k])}`)
+        .join("; ");
+    }
+    return <FieldList data={value} />;
+  }
+  return String(value);
+}
+
+function FieldList({
+  data,
+  skip,
+}: {
+  data: Record<string, any>;
+  skip?: string[];
+}) {
+  const skipped = new Set(skip || []);
+  const keys = Object.keys(data || {}).filter(
+    (k) => !skipped.has(k) && data[k] !== null && data[k] !== undefined && data[k] !== "",
+  );
+  if (keys.length === 0) return null;
+  return (
+    <ul className="mt-1 space-y-0.5 text-xs">
+      {keys.map((k) => (
+        <li key={k}>
+          <b>{labelFor(k)}:</b> {renderValue(data[k], 0)}
+        </li>
+      ))}
+    </ul>
+  );
+}
+
+function CueLine({ cue }: { cue: Record<string, any> }) {
+  return (
+    <span>
+      <b>{cue.cue_type || ""}</b>: {cue.name || ""}
+      <FieldList
+        data={cue}
+        skip={["cue_type", "name", "line", "scene_number", "shot_id"]}
+      />
+    </span>
+  );
