{
  "$defs": {
    "ambienceMode": {
      "enum": [
        "LOOP",
        "ONCE"
      ],
      "type": "string"
    },
    "aspectRatio": {
      "enum": [
        "16:9",
        "9:16"
      ],
      "type": "string"
    },
    "audioCue": {
      "additionalProperties": false,
      "properties": {
        "cue_id": {
          "description": "Structured SFX sub-block ID (e.g. SFX_001); empty for legacy one-line cues.",
          "type": "string"
        },
        "cue_type": {
          "$ref": "#/$defs/cueType"
        },
        "cue_type_text": {
          "description": "Structured SFX sub-block TYPE, verbatim; empty for legacy one-line cues.",
          "type": "string"
        },
        "duration": {
          "description": "Structured SFX sub-block DURATION, verbatim (e.g. 0.4s); empty for legacy cues.",
          "type": "string"
        },
        "duration_mode": {
          "description": "Structured SFX sub-block DURATION_MODE, verbatim; empty when not given.",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parsed seconds from duration when parseable; null otherwise."
        },
        "event": {
          "description": "Structured SFX sub-block EVENT, verbatim; empty for legacy one-line cues.",
          "type": "string"
        },
        "gain_db": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "MEME gain when given; null otherwise. Recorded as data only, never resolved to a file."
        },
        "intensity": {
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "mode": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "priority": {
          "type": "string"
        },
        "scene_number": {
          "minimum": 1,
          "type": "integer"
        },
        "shot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_key": {
          "description": "Original key as written, e.g. MUSIC for a BGM cue (legacy alias).",
          "type": "string"
        },
        "trigger": {
          "description": "A LINE_ID (validated) or free action text. Empty when not given.",
          "type": "string"
        }
      },
      "required": [
        "cue_type",
        "name",
        "trigger",
        "priority",
        "mode",
        "intensity",
        "gain_db",
        "scene_number",
        "shot_id",
        "line",
        "source_key",
        "cue_id",
        "event",
        "cue_type_text",
        "duration",
        "duration_mode",
        "duration_seconds"
      ],
      "type": "object"
    },
    "cameraMovement": {
      "enum": [
        "STATIC",
        "PAN_LEFT",
        "PAN_RIGHT",
        "TILT_UP",
        "TILT_DOWN",
        "DOLLY_IN",
        "DOLLY_OUT",
        "TRACKING",
        "CRANE_UP",
        "CRANE_DOWN",
        "HANDHELD"
      ],
      "type": "string"
    },
    "character": {
      "additionalProperties": false,
      "properties": {
        "appearance": {
          "type": "string"
        },
        "costume": {
          "description": "Default outfit.",
          "type": "string"
        },
        "costume_changes": {
          "items": {
            "$ref": "#/$defs/costumeChange"
          },
          "type": "array"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "head_ratio": {
          "description": "Locked range 0.33-0.35, default 0.34. Values outside (including 0.42) are validation errors.",
          "maximum": 0.35,
          "minimum": 0.33,
          "type": "number"
        },
        "id": {
          "description": "CHARACTER block id (e.g. CHAR_HITLER). In the legacy dialect the id equals the name.",
          "type": "string"
        },
        "identity_id": {
          "description": "Defaults to the block id; stable across costume changes.",
          "type": "string"
        },
        "is_extra": {
          "description": "True when VOICE: NONE or ROLE is 'Background extras'.",
          "type": "boolean"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "description": "Display name from NAME; in the legacy dialect, the CHARACTER name.",
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "traits": {
          "description": "Distinctive traits, ;-separated in the script.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "voice": {
          "description": "Kept verbatim; AUTO by default.",
          "type": "string"
        },
        "voice_style": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "appearance",
        "traits",
        "costume",
        "costume_changes",
        "voice",
        "voice_style",
        "head_ratio",
        "identity_id",
        "is_extra",
        "fields",
        "line"
      ],
      "type": "object"
    },
    "costumeChange": {
      "additionalProperties": false,
      "properties": {
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "outfit": {
          "type": "string"
        },
        "scene_number": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "scene_number",
        "outfit",
        "line"
      ],
      "type": "object"
    },
    "cueType": {
      "enum": [
        "SFX",
        "AMBIENCE",
        "BGM",
        "MEME",
        "VFX"
      ],
      "type": "string"
    },
    "endCard": {
      "additionalProperties": false,
      "properties": {
        "background": {
          "type": "string"
        },
        "bgm": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "duration_raw": {
          "description": "DURATION exactly as written (e.g. 3s).",
          "type": "string"
        },
        "duration_sec": {
          "description": "Parsed DURATION in seconds; same value as duration.",
          "type": "number"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "secondary_text": {
          "type": "string"
        },
        "sfx": {
          "type": "string"
        },
        "style": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "text_language": {
          "type": "string"
        }
      },
      "required": [
        "text",
        "duration",
        "style",
        "line",
        "background",
        "secondary_text",
        "text_language",
        "duration_raw",
        "duration_sec",
        "bgm",
        "sfx",
        "fields"
      ],
      "type": "object"
    },
    "expression": {
      "additionalProperties": false,
      "properties": {
        "character": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "expression": {
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "character",
        "expression",
        "line"
      ],
      "type": "object"
    },
    "frameRate": {
      "enum": [
        24,
        25,
        30
      ],
      "type": "integer"
    },
    "globalAudio": {
      "additionalProperties": false,
      "properties": {
        "ambience_gain_db": {
          "type": "number"
        },
        "bgm_ducking_db": {
          "type": "number"
        },
        "bgm_gain_db": {
          "type": "number"
        },
        "buses": {
          "const": [
            "narration",
            "dialogue",
            "ambience",
            "foley",
            "sfx",
            "bgm"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "dialogue_gain_db": {
          "type": "number"
        },
        "foley_gain_db": {
          "type": "number"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "master_limit_db": {
          "type": "number"
        },
        "narration_gain_db": {
          "type": "number"
        },
        "sfx_gain_db": {
          "type": "number"
        }
      },
      "required": [
        "narration_gain_db",
        "dialogue_gain_db",
        "ambience_gain_db",
        "foley_gain_db",
        "sfx_gain_db",
        "bgm_gain_db",
        "bgm_ducking_db",
        "master_limit_db",
        "buses",
        "fields"
      ],
      "type": "object"
    },
    "intensity": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH"
      ],
      "type": "string"
    },
    "location": {
      "additionalProperties": false,
      "properties": {
        "architecture": {
          "type": "string"
        },
        "background": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "Background layer: legacy single value (string) or new-dialect bullet list (array)."
        },
        "features": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "forbidden": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "foreground": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "Foreground layer: legacy single value (string) or new-dialect bullet list (array)."
        },
        "geography": {
          "type": "string"
        },
        "id": {
          "description": "LOCATION block id; scenes reference it by exact match.",
          "type": "string"
        },
        "lighting": {
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "midground": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          ],
          "description": "Midground layer: legacy single value (string) or new-dialect bullet list (array)."
        },
        "name": {
          "type": "string"
        },
        "palette": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "period": {
          "type": "string"
        },
        "type": {
          "description": "LOCATION TYPE (e.g. INTERIOR, EXTERIOR); empty when not declared.",
          "type": "string"
        },
        "weather": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "period",
        "geography",
        "architecture",
        "features",
        "foreground",
        "midground",
        "background",
        "lighting",
        "weather",
        "palette",
        "forbidden",
        "type",
        "fields",
        "line"
      ],
      "type": "object"
    },
    "memePolicy": {
      "enum": [
        "CONTEXTUAL",
        "NONE",
        "ALWAYS"
      ],
      "type": "string"
    },
    "meta": {
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": {
          "$ref": "#/$defs/aspectRatio"
        },
        "external_narrator": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "EXTERNAL_NARRATOR declaration; must be NONE in first-person documents (SPEC §16), null when absent."
        },
        "genre": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the GENRE header is absent (unspecified, SPEC §4); no upstream default is inherited."
        },
        "language": {
          "default": "vi-VN",
          "type": "string"
        },
        "meme_max_per_minute": {
          "minimum": 0,
          "type": "integer"
        },
        "meme_policy": {
          "$ref": "#/$defs/memePolicy"
        },
        "primary_character": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "PRIMARY_CHARACTER block id; must reference a declared CHARACTER (SPEC §16), null when absent."
        },
        "project": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the PROJECT header is absent (unspecified, SPEC §4); no upstream default is inherited."
        },
        "project_fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "project_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "PROJECT_ID from the PROJECT block; null when absent."
        },
        "storytelling_mode": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "STORYTELLING_MODE from the PROJECT block (e.g. FIRST_PERSON_ROLEPLAY); null when absent."
        },
        "target_duration": {
          "description": "AUTO, a plain number of seconds, or a range such as '85–100 seconds', verbatim.",
          "type": "string"
        },
        "target_duration_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parsed upper bound of TARGET_DURATION; null for AUTO or unparseable values."
        },
        "target_duration_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parsed lower bound of TARGET_DURATION (equal to the max for a plain number); null for AUTO or unparseable values."
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "TITLE from the PROJECT block; null when absent."
        },
        "tone": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when the TONE header is absent (unspecified, SPEC §4); no upstream default is inherited."
        },
        "visual_style": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Single field for the STYLE / VISUAL_STYLE alias rule (SPEC §4): the value of whichever key is present, VISUAL_STYLE on conflict, null when neither is present. There is no separate 'style' field."
        },
        "visual_style_fields": {
          "$ref": "#/$defs/verbatimFields"
        }
      },
      "required": [
        "project",
        "language",
        "genre",
        "visual_style",
        "aspect_ratio",
        "target_duration",
        "tone",
        "meme_policy",
        "meme_max_per_minute",
        "storytelling_mode",
        "primary_character",
        "external_narrator",
        "project_id",
        "title",
        "project_fields",
        "visual_style_fields",
        "target_duration_min",
        "target_duration_max"
      ],
      "type": "object"
    },
    "outputConfig": {
      "additionalProperties": false,
      "properties": {
        "draft_folder": {
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "format": {
          "const": "MP4"
        },
        "fps": {
          "$ref": "#/$defs/frameRate"
        },
        "master": {
          "const": "MANUAL_ONLY",
          "description": "A Master is never automatic; any other value is a validation error."
        },
        "resolution": {
          "$ref": "#/$defs/resolution"
        }
      },
      "required": [
        "resolution",
        "fps",
        "format",
        "draft_folder",
        "master",
        "fields"
      ],
      "type": "object"
    },
    "priority": {
      "enum": [
        "REQUIRED",
        "OPTIONAL"
      ],
      "type": "string"
    },
    "prop": {
      "additionalProperties": false,
      "properties": {
        "all_scenes": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "id": {
          "description": "PROP block id; in the legacy dialect the id equals the name.",
          "type": "string"
        },
        "interactions": {
          "description": "Interaction verbs, ;-separated in the script.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "owner": {
          "description": "Character name, or NONE / empty for no owner.",
          "type": "string"
        },
        "scenes": {
          "description": "Scene numbers; empty when all_scenes is true.",
          "items": {
            "minimum": 1,
            "type": "integer"
          },
          "type": "array"
        },
        "type": {
          "description": "PROP TYPE (e.g. DOCUMENT, WEAPON); empty when not declared.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "owner",
        "scenes",
        "all_scenes",
        "interactions",
        "type",
        "fields",
        "line"
      ],
      "type": "object"
    },
    "qaConfig": {
      "additionalProperties": false,
      "properties": {
        "expected_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "Parsed EXPECTED_* counts from the QA block, keyed by lowercase name (e.g. expected_scenes).",
          "type": "object"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "language_gate": {
          "type": "boolean"
        },
        "max_hard_fails": {
          "minimum": 0,
          "type": "integer"
        },
        "min_score": {
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        "require_creative_review": {
          "type": "boolean"
        },
        "require_technical": {
          "type": "boolean"
        }
      },
      "required": [
        "min_score",
        "require_technical",
        "require_creative_review",
        "language_gate",
        "max_hard_fails",
        "fields",
        "expected_counts"
      ],
      "type": "object"
    },
    "resolution": {
      "enum": [
        "1920x1080",
        "1280x720"
      ],
      "type": "string"
    },
    "scene": {
      "additionalProperties": false,
      "properties": {
        "actions": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ambience_none": {
          "type": "boolean"
        },
        "audio_cues": {
          "items": {
            "$ref": "#/$defs/audioCue"
          },
          "type": "array"
        },
        "bgm_none": {
          "type": "boolean"
        },
        "camera": {
          "description": "Scene default camera description.",
          "type": "string"
        },
        "camera_movement": {
          "$ref": "#/$defs/cameraMovement"
        },
        "camera_movement_text": {
          "description": "Scene CAMERA_MOVEMENT exactly as written; empty when no CAMERA_MOVEMENT line was given.",
          "type": "string"
        },
        "characters": {
          "description": "Scene CHARACTERS list of CHARACTER block ids; empty when NONE.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "costume": {
          "description": "Scene COSTUME (e.g. CIVILIAN, MILITARY); empty when not declared.",
          "type": "string"
        },
        "duration": {
          "description": "AUTO or seconds, verbatim.",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "expressions": {
          "items": {
            "$ref": "#/$defs/expression"
          },
          "type": "array"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "id": {
          "description": "Scene block id (e.g. SC01) in the new dialect; empty in the legacy dialect, where scenes are numbered only.",
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "location_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "LOCATION block id when the scene LOCATION matches an id exactly; otherwise null."
        },
        "location_text": {
          "description": "Inline free-text location when no LOCATION id matches; empty when location_ref is set.",
          "type": "string"
        },
        "meme_none": {
          "type": "boolean"
        },
        "meme_note": {
          "type": "string"
        },
        "mood": {
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "type": "integer"
        },
        "sfx_none": {
          "description": "True when SFX: NONE was declared; no SFX may be invented.",
          "type": "boolean"
        },
        "shots": {
          "items": {
            "$ref": "#/$defs/shot"
          },
          "type": "array"
        },
        "spoken_lines": {
          "items": {
            "$ref": "#/$defs/spokenLine"
          },
          "type": "array"
        },
        "time_of_day": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "transition": {
          "description": "Scene TRANSITION, verbatim. In legacy documents it is one of the transition vocabulary; in new-dialect documents any descriptive value is preserved (SPEC §6.11).",
          "type": "string"
        },
        "vfx_cues": {
          "description": "VFX lines, stored with cue_type VFX.",
          "items": {
            "$ref": "#/$defs/audioCue"
          },
          "type": "array"
        },
        "visual": {
          "type": "string"
        },
        "voice_note": {
          "type": "string"
        }
      },
      "required": [
        "number",
        "id",
        "title",
        "line",
        "location_ref",
        "location_text",
        "time_of_day",
        "mood",
        "duration",
        "duration_seconds",
        "visual",
        "actions",
        "expressions",
        "camera",
        "camera_movement",
        "camera_movement_text",
        "characters",
        "costume",
        "fields",
        "voice_note",
        "meme_note",
        "transition",
        "sfx_none",
        "ambience_none",
        "bgm_none",
        "meme_none",
        "shots",
        "spoken_lines",
        "audio_cues",
        "vfx_cues"
      ],
      "type": "object"
    },
    "shot": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "camera_movement": {
          "anyOf": [
            {
              "$ref": "#/$defs/cameraMovement"
            },
            {
              "type": "null"
            }
          ],
          "description": "Enum movement when declared (STATIC by default); null when CAMERA_MOVEMENT is descriptive prose (see camera_movement_text)."
        },
        "camera_movement_text": {
          "description": "CAMERA_MOVEMENT exactly as written; empty when no CAMERA_MOVEMENT line was given.",
          "type": "string"
        },
        "duration": {
          "description": "AUTO or seconds, verbatim.",
          "type": "string"
        },
        "duration_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "end_hold": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parsed END_HOLD in seconds; null when not declared."
        },
        "end_hold_raw": {
          "description": "END_HOLD exactly as written (e.g. 0.6s); empty when not declared.",
          "type": "string"
        },
        "expression": {
          "type": "string"
        },
        "fields": {
          "$ref": "#/$defs/verbatimFields"
        },
        "id": {
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "location_override": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "LOCATION_OVERRIDE block id; null when not declared."
        },
        "post_dialogue_pause": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Parsed POST_DIALOGUE_PAUSE in seconds; null when not declared."
        },
        "post_dialogue_pause_raw": {
          "description": "POST_DIALOGUE_PAUSE exactly as written (e.g. 0.6s); empty when not declared.",
          "type": "string"
        },
        "spoken_line_ids": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "subject": {
          "type": "string"
        },
        "trigger": {
          "description": "TRIGGER exactly as written (LINE_ID + quote); empty when not declared.",
          "type": "string"
        },
        "trigger_line_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "LINE_ID parsed from TRIGGER when it starts with one; null otherwise."
        },
        "type": {
          "anyOf": [
            {
              "$ref": "#/$defs/shotType"
            },
            {
              "type": "null"
            }
          ],
          "description": "Shot type enum when TYPE is declared; null in new-dialect shots that declare CAMERA only (SPEC §5.5)."
        },
        "type_raw": {
          "description": "TYPE value exactly as written, before normalization.",
          "type": "string"
        },
        "vfx": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "voice_note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "line",
        "type",
        "type_raw",
        "camera",
        "camera_movement",
        "camera_movement_text",
        "location_override",
        "trigger",
        "trigger_line_id",
        "post_dialogue_pause",
        "post_dialogue_pause_raw",
        "end_hold",
        "end_hold_raw",
        "fields",
        "subject",
        "duration",
        "duration_seconds",
        "action",
        "expression",
        "vfx",
        "voice_note",
        "spoken_line_ids"
      ],
      "type": "object"
    },
    "shotType": {
      "description": "Must match camera_planner.SHOT_TYPES exactly. Input is normalized to lower_snake (UPPER_SNAKE accepted).",
      "enum": [
        "establishing",
        "medium",
        "close_up",
        "extreme_close_up",
        "over_the_shoulder",
        "reaction",
        "object_insert",
        "tracking",
        "shot_reverse_shot"
      ],
      "type": "string"
    },
    "spokenKind": {
      "enum": [
        "narration",
        "dialogue"
      ],
      "type": "string"
    },
    "spokenLine": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/spokenKind"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "line_id": {
          "description": "Explicit id if given (legacy [Lnn] form or a verbatim id such as EP01_FP_01), else auto L001, L002... in document order.",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*$",
          "type": "string"
        },
        "lip_sync": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "LIP_SYNC value for this line (e.g. REQUIRED); null when not declared."
        },
        "scene_number": {
          "minimum": 1,
          "type": "integer"
        },
        "shot_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Containing shot id, or null when the line is directly in the scene."
        },
        "speaker": {
          "description": "Canonical declared character display name, or 'Narrator' for legacy narrator lines.",
          "type": "string"
        },
        "speaker_id": {
          "description": "CHARACTER block id of the speaker; empty for legacy narrator lines.",
          "type": "string"
        },
        "text": {
          "description": "Spoken text, never rewritten.",
          "type": "string"
        },
        "voice_note": {
          "type": "string"
        }
      },
      "required": [
        "line_id",
        "speaker",
        "speaker_id",
        "lip_sync",
        "text",
        "kind",
        "voice_note",
        "scene_number",
        "shot_id",
        "line"
      ],
      "type": "object"
    },
    "transition": {
      "enum": [
        "CUT",
        "DISSOLVE",
        "FADE",
        "FADE_TO_BLACK",
        "MATCH_CUT",
        "WIPE"
      ],
      "type": "string"
    },
    "unsupportedField": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "description": "Where the field appeared: document, a block name, character:<name>, location:<id>, prop:<name>, scene:<n>, or shot:<id>.",
          "type": "string"
        },
        "key": {
          "type": "string"
        },
        "line": {
          "minimum": 1,
          "type": "integer"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "value",
        "line",
        "context"
      ],
      "type": "object"
    },
    "validationIssue": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "description": "SPEC §8.2 error code (V1E001–V1E025). Parsers emit exactly these codes; V1E022 is timeline-stage only and never appears in parse output. V1E025 is an error in first-person documents and a warning in legacy documents with narrator lines (SPEC §16).",
          "pattern": "^V1E0\\d\\d$",
          "type": "string"
        },
        "line": {
          "description": "1-based source line; 0 means a document-level issue.",
          "minimum": 0,
          "type": "integer"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "line",
        "code",
        "message"
      ],
      "type": "object"
    },
    "verbatimFields": {
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string"
          },
          {
            "items": {
              "type": "string"
            },
            "type": "array"
          }
        ]
      },
      "description": "Verbatim block fields: every declared KEY: value exactly as written (string), or the list of bullet items / repeated values (array of strings). Nothing declared is ever silently discarded.",
      "type": "object"
    }
  },
  "$id": "https://ai-clip-studio.local/schemas/studio_script_v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Machine-readable schema for the to_dict() output of ai_clip_studio.studio_script_v1. Describes a VALID document: when is_valid is false, individual fields (e.g. head_ratio, shot type) may fall outside the enums/ranges below, and validation_errors explains why. Consumers should check is_valid first. Head ratio is locked to 0.33-0.35 (default 0.34); the upstream 0.42 default is never valid here.",
  "properties": {
    "characters": {
      "items": {
        "$ref": "#/$defs/character"
      },
      "type": "array"
    },
    "constraints": {
      "description": "GLOBAL_NEGATIVE_CONSTRAINTS lines, in document order.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "end_card": {
      "anyOf": [
        {
          "$ref": "#/$defs/endCard"
        },
        {
          "type": "null"
        }
      ],
      "description": "Null when the document has no END_CARD block."
    },
    "format": {
      "const": "studio_script_v1"
    },
    "global_audio": {
      "$ref": "#/$defs/globalAudio"
    },
    "is_valid": {
      "type": "boolean"
    },
    "locations": {
      "items": {
        "$ref": "#/$defs/location"
      },
      "type": "array"
    },
    "meta": {
      "$ref": "#/$defs/meta"
    },
    "output": {
      "$ref": "#/$defs/outputConfig"
    },
    "props": {
      "items": {
        "$ref": "#/$defs/prop"
      },
      "type": "array"
    },
    "qa": {
      "$ref": "#/$defs/qaConfig"
    },
    "scenes": {
      "items": {
        "$ref": "#/$defs/scene"
      },
      "type": "array"
    },
    "snapshot_hash": {
      "description": "SHA-256 hex of the exact raw input text (UTF-8).",
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "unsupported_fields": {
      "items": {
        "$ref": "#/$defs/unsupportedField"
      },
      "type": "array"
    },
    "validation_errors": {
      "items": {
        "$ref": "#/$defs/validationIssue"
      },
      "type": "array"
    },
    "warnings": {
      "items": {
        "$ref": "#/$defs/validationIssue"
      },
      "type": "array"
    }
  },
  "required": [
    "format",
    "snapshot_hash",
    "is_valid",
    "meta",
    "characters",
    "locations",
    "props",
    "scenes",
    "global_audio",
    "constraints",
    "qa",
    "output",
    "end_card",
    "unsupported_fields",
    "validation_errors",
    "warnings"
  ],
  "title": "STUDIO SCRIPT V1 document",
  "type": "object"
}