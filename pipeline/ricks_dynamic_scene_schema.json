{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RicksDynamicTimeline",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["scene_id", "timestamp", "narrative", "charmotion", "visual_composition", "audio_dynamics"],
    "properties": {
      "scene_id": {"type": "string", "pattern": "^scene_[0-9]{3}$"},
      "timestamp": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0}}},
      "narrative": {"type": "object", "required": ["text", "voice_profile", "emotion_tagging"], "properties": {"text": {"type": "string", "minLength": 1}, "voice_profile": {"type": "string", "minLength": 1}, "emotion_tagging": {"type": "string", "pattern": "^(\\[[a-z_]+\\])+$"}}},
      "charmotion": {"type": "object", "required": ["avatar_id", "pipeline", "motion_intensity", "driving_video_ref"], "properties": {"avatar_id": {"type": "string", "minLength": 1}, "pipeline": {"type": "string", "enum": ["LivePortrait", "SadTalker"]}, "motion_intensity": {"type": "number", "minimum": 0, "maximum": 1}, "driving_video_ref": {"type": "string", "minLength": 1}}},
      "visual_composition": {"type": "object", "required": ["b_roll_source", "screen_effect", "subtitle_style"], "properties": {"b_roll_source": {"type": "string", "minLength": 1}, "screen_effect": {"type": "string", "minLength": 1}, "subtitle_style": {"type": "string", "minLength": 1}}},
      "audio_dynamics": {"type": "object", "required": ["bgm_track", "ducking_level", "sfx_triggers"], "properties": {"bgm_track": {"type": "string", "minLength": 1}, "ducking_level": {"type": "number", "minimum": 0, "maximum": 1}, "sfx_triggers": {"type": "array", "items": {"type": "string", "pattern": "^f\\+[0-9]+:[^:]+$"}}}}
    }
  }
}
